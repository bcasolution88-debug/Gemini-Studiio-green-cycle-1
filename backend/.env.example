# ===== 绿循环后端环境变量（复制为 .env 后填写）=====

# 运行模式：production 下会拒绝默认 JWT 密钥、默认不写演示数据
GC_ENV=production

# 必填：JWT 签名密钥（生成：openssl rand -hex 32）
GC_JWT_SECRET=

# token 有效期（天）
GC_TOKEN_TTL_DAYS=30

# 允许的跨域来源（逗号分隔；原生 App 不受 CORS 限制，仅 Web 端需要）。留空 = 放行所有来源
GC_CORS_ORIGINS=https://app.example.com,https://admin.example.com

# 首次启动创建的初始管理员（生产不写演示账号）
GC_ADMIN_PHONE=13900000000
GC_ADMIN_PASSWORD=
GC_ADMIN_NAME=平台管理员

# 是否写入演示数据（演示用户/回收员/历史订单）。生产请保持 0
GC_SEED_DEMO=0

# 推送（可选）：FCM 服务账号 JSON 在容器内的路径（通过 volume 挂载）
# GC_FCM_SERVICE_ACCOUNT=/secrets/fcm-service-account.json
# GC_PUSH_DRY_RUN=0

# 生产 HTTPS（docker-compose.prod.yml 使用 Caddy 自动签发 Let's Encrypt 证书）
API_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com
